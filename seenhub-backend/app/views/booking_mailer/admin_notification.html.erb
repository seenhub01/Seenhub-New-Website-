<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: 'Inter', sans-serif; line-height: 1.6; color: #1e293b; max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background: #d88906; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
      .content { background: #ffffff; padding: 30px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 8px 8px; }
      .details { background: #f8fafc; padding: 15px; border-radius: 8px; margin: 20px 0; }
      .detail-row { display: flex; justify-content: space-between; margin-bottom: 8px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; }
      .detail-label { font-weight: 600; color: #64748b; }
      .detail-value { font-weight: 700; color: #0f172a; }
      .btn { display: inline-block; padding: 10px 20px; background: #0f172a; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 700; }
    </style>
  </head>
  <body>
    <div class="header">
      <h2 style="color: #ffffff; margin: 0;">New Booking Alert</h2>
    </div>
    <div class="content">
      <p>A new booking has been made on the SeenHub platform.</p>
      
      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Customer</span>
          <span class="detail-value"><%= @booking.name %> (<%= @booking.email %>)</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Service</span>
          <span class="detail-value"><%= @booking.space || @booking.category %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Total Amount</span>
          <span class="detail-value">AED <%= @booking.total || @booking.totalAmount %></span>
        </div>
      </div>

      <p>Please log in to the Admin Panel to manage this booking.</p>
      <a href="https://seenhub.ae/admin" class="btn">Go to Admin Panel</a>
    </div>
  </body>
</html>
