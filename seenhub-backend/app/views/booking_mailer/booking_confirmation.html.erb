<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: 'Inter', sans-serif; line-height: 1.6; color: #1e293b; max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background: #0f172a; padding: 30px; text-align: center; border-radius: 12px 12px 0 0; }
      .content { background: #ffffff; padding: 40px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 12px 12px; }
      .footer { text-align: center; margin-top: 30px; font-size: 12px; color: #94a3b8; }
      .booking-id { color: #64748b; font-size: 14px; margin-bottom: 20px; }
      .btn { display: inline-block; padding: 12px 24px; background: #0f172a; color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 700; margin-top: 20px; }
      .details { background: #f8fafc; padding: 20px; border-radius: 8px; margin: 20px 0; }
      .detail-row { display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px; }
      .detail-label { font-weight: 600; color: #64748b; }
      .detail-value { font-weight: 700; color: #0f172a; }
    </style>
  </head>
  <body>
    <div class="header">
      <h1 style="color: #ffffff; margin: 0;">SeenHub</h1>
    </div>
    <div class="content">
      <h2>Booking Confirmed!</h2>
      <p>Hi <%= @booking.name %>,</p>
      <p>Thank you for choosing SeenHub. Your booking has been successfully confirmed. Please find the details below:</p>
      
      <div class="booking-id">Booking ID: #<%= @booking.id %></div>

      <div style="text-align: center; margin: 25px 0; padding: 20px; background: #fff; border: 2px dashed #e2e8f0; border-radius: 12px;">
        <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase; margin-bottom: 10px; font-weight: 800; letter-spacing: 1px;">Your Entry QR Code</div>
        <%= image_tag attachments['qrcode.png'].url, alt: 'Booking QR Code', style: 'width: 180px; height: 180px;' %>
        <div style="margin-top: 10px; font-size: 12px; color: #64748b;">Show this at the reception for check-in</div>
      </div>

      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Service</span>
          <span class="detail-value"><%= @booking.space || @booking.category %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Date</span>
          <span class="detail-value"><%= @booking.date %></span>
        </div>
        <% if @booking.timeFrom %>
        <div class="detail-row">
          <span class="detail-label">Time</span>
          <span class="detail-value"><%= @booking.timeFrom %> - <%= @booking.timeTo %></span>
        </div>
        <% end %>
        <div class="detail-row">
          <span class="detail-label">Total Amount</span>
          <span class="detail-value">AED <%= @booking.total || @booking.totalAmount %></span>
        </div>
      </div>

      <p>If you have any questions, feel free to contact us at info@seenhub.ae.</p>
      
      <a href="https://seenhub.ae/dashboard" class="btn">View in Dashboard</a>
    </div>
    <div class="footer">
      <p>&copy; 2026 SeenHub. All rights reserved.</p>
      <p>Al Ain, United Arab Emirates</p>
    </div>
  </body>
</html>
